[Unit]
Description=Gmail Organizer - AI 기반 이메일 자동 정리 서비스
After=network.target

[Service]
Type=simple
User=kkaemo
WorkingDirectory=/home/kkaemo/projects/gmail-organizer
Environment=PATH=/home/kkaemo/projects/gmail-organizer/venv/bin:/usr/bin:/bin
ExecStart=/home/kkaemo/projects/gmail-organizer/venv/bin/python scheduler.py --interval 60 --batch-size 50
Restart=always
RestartSec=60

# 로그 설정
StandardOutput=append:/home/kkaemo/projects/gmail-organizer/logs/service.log
StandardError=append:/home/kkaemo/projects/gmail-organizer/logs/service_error.log

# 환경변수 파일
EnvironmentFile=/home/kkaemo/projects/gmail-organizer/.env

[Install]
WantedBy=multi-user.target

